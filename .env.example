# Copy to .env. Docker Compose loads this file; local go run uses shell variables.
USERS_HTTP_ADDR=:8080
INTERNAL_SERVICE_TOKEN=
VPN_API_URL=http://127.0.0.1:8081
USERS_API_URL=http://127.0.0.1:8080
VPN_CONFIGS_HTTP_ADDR=:8081
# Generate distinct random hex passwords before starting Compose.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
USERS_MONGO_PASSWORD=
VPN_CONFIGS_MONGO_PASSWORD=
# Local go run: set MONGO_URI to the appropriate authenticated endpoint.
# Compose supplies MONGO_URI and MONGO_DATABASE per service.
YANDEX_CLIENT_ID=
# Exact verified Yandex subject of the only administrator. Empty means no admin.
ADMIN_YANDEX_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=http://localhost:8080/auth/yandex/callback
# Current SSH adapter settings; server registry does not select the live host yet.
VPN_HOST_ADDRESS=
# For the SSH adapter use host:port, e.g. vpn.example.org:22.
VPN_HOST_USERNAME=
VPN_HOST_PASSWORD=
# Path INSIDE the backend environment; mount a verified known_hosts file for Docker.
VPN_KNOWN_HOSTS_FILE=
# Public VPN host:UDP-port from docker port amnezia-awg2 (not SSH port).
# Confirmed UDP port for the current server: 39977, e.g. vpn.example.org:39977.
VPN_PUBLIC_ENDPOINT=
# Base64 of 32 random bytes. Back up separately; losing this key loses access to files.
VPN_CONFIG_ENCRYPTION_KEY=

# Browser origin; use https://worldofleprechauns.ru in production.
FRONTEND_ORIGIN=http://localhost:5173

# Optional redirects after authentication; empty keeps /me and / for local proxy.
AUTH_SUCCESS_REDIRECT_URL=
AUTH_LOGOUT_REDIRECT_URL=
